\section{Constraints}

Each slot of each position can have one job at a time:

\begin{equation}
    \sum_{j \in \mathcal{J}} x_{spj} \leq 1 \; \forall s \in \mathcal{S}, \,\forall p \in \mathcal{P} \label{eq:cSingleJobPerSlot}
\end{equation}


Calculation of the slot duration

\begin{equation}
     d^J_{spj} = f^J_{spj} - s^J_{spj}\; \forall s \in \mathcal{S}, \,\forall p \in \mathcal{P} , \,\forall j \in \mathcal{J} \label{eq:cSlotJobDuration}
\end{equation}

Starting and finishing times are 0 if the job is not assigned to a position

\begin{align}
s^J_{spj} &\;\le\; H \cdot x_{spj}
&& \forall\, s \in \mathcal{S},\; \forall\, p \in \mathcal{P},\; \forall\, j \in \mathcal{J}
\label{eq:nullStartIfNotAssigned}
\\[6pt]
f^J_{spj} &\;\le\; H \cdot x_{spj}
&& \forall\, s \in \mathcal{S},\; \forall\, p \in \mathcal{P},\; \forall\, j \in \mathcal{J}
\label{eq:nullFinishIfNotAssigned}
\end{align}


The total duration of a job is the sum of the duration of all corresponding slots:

\begin{equation}
\begin{split}
     \sum_{s \in \mathcal{S}}\sum_{p \in \mathcal{P}}d^J_{spj} = D_{j},\, \forall j \in \mathcal{J} \label{eq:cJobDuration} \\
\end{split}     
\end{equation}


Calculating the starting and finishing times for each job.

% -------------------------------------------------------------------
% (1) El inicio global s_j no puede ser mayor que el inicio s^J_spj
%     si el job j ocupa el slot s en la posición p
\begin{equation}
\begin{aligned}
s_j &\;\le\; s^J_{spj} \;+\; H \,\bigl(1 - x_{spj}\bigr)
&& \forall\,s \in S,\; p \in P,\; j \in J
\end{aligned}
\label{eq:startGlobalLowerBoundNoCommas}
\end{equation}

% -------------------------------------------------------------------
% (2) El fin global f_j debe ser al menos el fin f^J_spj de cada (s,p) asignado
\begin{equation}
\begin{aligned}
f_j &\;\ge\; f^J_{spj} \;-\; H \,\bigl(1 - x_{spj}\bigr)
&& \forall\,s \in S,\; p \in P,\; j \in J
\end{aligned}
\label{eq:finishGlobalUpperBoundNoCommas}
\end{equation}

% -------------------------------------------------------------------
% (3) La coherencia: no se puede finalizar antes de empezar
\begin{equation}
s_j \;\le\; f_j
\quad \forall\,j \in J.
\label{eq:noNegativeDurationNoCommas}
\end{equation}
% -------------------------------------------------------------------

Initial and finishing times for each slot:

\begin{align}
s^S_{sp} &= \sum_{j \in \mathcal{J}} s^J_{spj}
&& \forall\, s \in \mathcal{S},\; \forall\, p \in \mathcal{P}
\label{eq:slotStartTimeFromJobs}
\\[6pt]
f^S_{sp} &= \sum_{j \in \mathcal{J}} f^J_{spj}
&& \forall\, s \in \mathcal{S},\; \forall\, p \in \mathcal{P}
\label{eq:slotFinishTimeFromJobs}
\end{align}


Slot within the same position are sequenced:

\begin{equation}
\begin{split}
      s^S_{sp} \leq f^S_{s-1\,p},\, \forall s \in \mathcal{S} :s>1
,\ p \in \mathcal{P} \label{eq:SlotSequence} \\
\end{split}     
\end{equation}


Jobs are sequenced:

\begin{equation}
s_{j'} \;\ge\; f_j 
\quad \forall\, j,\, j' \in \mathcal{J} \;/\; P_{jj'} = 1
\label{eq:jobPrecedence}
\end{equation}


Subsequent tasks in a position correspond to different planes:

\begin{equation}
\begin{split}
      1 + z_{sp} \geq y_{spr} + y_{s+1 p r'} 
      ,\, \forall s \in \mathcal{S},\, \forall p \in \mathcal{P} ,\, \forall r, r' \in \mathcal{R} / r \neq r'
      \label{eq:PlaneSwitchInPOsition} \\
\end{split}     
\end{equation}


A given slot is not used unless all the previous ones have been used

\begin{equation}
\begin{aligned}
\sum_{j \in J} x_{spj} &\;\le\; \sum_{j \in J} x_{s-1\,p\,j} \\
&\quad \forall\, s = 2,\dots,|S|,\; \forall\, p \in P
\end{aligned}
\label{eq:noEmptySlots}
\end{equation}

A job can be assigned to a single slot of a position:

\begin{align}
% *
\sum_{p \in P}\sum_{s \in S} x_{jsp} \leq 1 \quad \forall j \in \mathcal{J}
\end{align}


If a job is not assigned to a slot of a position, the duration of that job in that slot of that position is zero:

\begin{equation}
\begin{split}
     d^J_{spj}  \leq D_{j} x_{spj} ,\, \forall s \in \mathcal{S},\,p \in \mathcal{P},\,j \in \mathcal{J} \label{eq:cJobDuration} \\
\end{split}     
\end{equation}

Airplane-job consistency assignment
\begin{equation}
    y_{spr} = \sum_{j \in \mathcal{J}_r} x_{spj}  \; \forall s \in \mathcal{S}, \,\forall p \in \mathcal{P} , \,\forall r \in \mathcal{R} \label{eq:cPlaneSlotAssignment}
\end{equation}

Airplane with some job in a position.
\begin{equation}
    w_{rp} \geq y_{spr}  \; \forall s \in \mathcal{S}, \,\forall p \in \mathcal{P} , \,\forall r \in \mathcal{R} \label{eq:cPlaneSlotAssignment}
\end{equation}


The duration of a slot is that of the slot assigned to that job
\begin{equation}
\begin{split}
      d^S_{sp} = \sum_{j \in \mathcal{J}} d^J_{spj},\, \forall s \in \mathcal{S},\,
      \forall p \in \mathcal{P}\\
\end{split}     
\end{equation}

Computing if the starting time of slot s in position p is earlier than the starting time of slot s' in position p':

\begin{equation}
    H \times \beta^S_{s,s',p,p'} + s^S_{sp} \geq s^S_{s'p'} ,\ \forall s,s' \in \mathcal{S},\, \forall p, p' \in \mathcal{P} / B_{pp'}=1
    \label{eq:fcBetaDefinion1}
\end{equation}

Computing if the finishing time of slot s in position p is later than the starting time of slot s' in position p'

\begin{equation}
    H \times \beta^F_{s,s',p,p'} + s^S_{s'p'} \geq f^S_{sp} ,\ \forall s,s' \in \mathcal{S},\, \forall p, p' \in \mathcal{P} / B_{pp'}=1
    \label{eq:fcBetaDefinion2}
\end{equation}


The starting time of slot s in position p is earlier than the starting time of slot s' in position p' and finishing time of slot s in position p is later than the starting time of slot s' in position p'

\begin{equation}
\begin{split}
      1 + \alpha_{ss'pp'} \geq \beta^S_{ss'pp'} + \beta^F_{ss'pp'},\, \forall s \in \mathcal{S},\,s' \in \mathcal{S},\,\forall p \in \mathcal{P},\,\forall p' \in \mathcal{P} / B_{pp'}=1\\
\end{split}     
\end{equation}

\section{Objective function}\

\begin{align}
\mbox{min.}  & \sum_{s \in \mathcal{S}} \sum_{p \in \mathcal{P}} \sum_{j \in \mathcal{J}} x_{spj} \\ 
& + \sum_{s \in \mathcal{S}}\sum_{s' \in \mathcal{S}} \sum_{p \in \mathcal{P}} \sum_{p' \in \mathcal{P}} \alpha_{ss'pp'}  \\
& + \sum_{s \in \mathcal{S}}\sum_{p \in \mathcal{P}}\sum_{r \in \mathcal{R}} y_{spr}
\end{align} 